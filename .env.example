# Copie para .env.local e preencha. Nada daqui vai para o navegador (só variáveis VITE_* iriam).
#
# E-mail (envio do relatório diário). Com Gmail, ative a verificação em duas etapas e
# gere uma "senha de app" em https://myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# TLS direto. Se omitido: true na porta 465, false nas outras (587 usa STARTTLS).
# SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
# Nome exibido como remetente quando o painel não informar a marca da agência.
EMAIL_FROM_NAME=AB AdsDesk
# Endereço que recebe as respostas do cliente. Se omitido, as respostas vão para o SMTP_USER.
# EMAIL_REPLY_TO=contato@suaagencia.com.br
# Por padrão só este computador pode chamar /api/email. Use true apenas atrás de autenticação.
# EMAIL_ALLOW_REMOTE=false
#
# O token da Meta é informado pela tela "Conectar conta da Meta" e fica só no navegador.
# Quando existir um backend (ver wiki/pontos-de-melhoria.md), ele deve vir para cá.
